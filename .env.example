# Скопируй в .env и заполни:  cp .env.example .env

# --- Telegram ---------------------------------------------------------------
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=

# --- OpenAI / OpenRouter ----------------------------------------------------
# Ключи API. Для OpenRouter: openrouter.ai/keys
#
# Можно перечислить несколько через запятую — лимиты считаются на ключ,
# так что несколько ключей = несколько квот. Упёрлись в лимит на одном — бот сам
# переходит на следующий, а исчерпанный откладывает на LLM_KEY_COOLDOWN.
OPENAI_API_KEYS=

# Базовый эндпоинт. По умолчанию — OpenRouter:
#   https://openrouter.ai/api/v1
# Можно указать свой (совместимый с OpenAI) — например локальную llama.cpp.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Модели пробуются по порядку: когда Terra исчерпана на всех ключах, бот
# переключается на Luna и продолжает отвечать.
# LLM_MODEL=openai/gpt-5.6-terra,openai/gpt-5.6-luna

# --- Доступ -----------------------------------------------------------------
# ВАЖНО: если все три списка пустые, бота может звать кто угодно во всех чатах
# Telegram и тратить твою квоту. Бот предупредит об этом в логе при старте.

# Админы: могут звать бота всегда и управлять доступом командами прямо в чате
# (/add, /del, /list). Свой ID можно узнать у @userinfobot.
ADMIN_USER_IDS=

# Постоянные записи. Команда /del их не уберёт — только правка этого файла и
# перезапуск. Всех остальных удобнее добавлять через /add.
# ALLOWED_USER_IDS — эти люди зовут бота где угодно.
# ALLOWED_CHAT_IDS — открывает бота всем в конкретном чате (ID групп отрицательные).
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=

# --- Публичный доступ -------------------------------------------------------
# 0 — бот приватный, отвечает только по спискам выше. Любое другое число
# открывает его всему Telegram с таким лимитом запросов в сутки на человека.
#
# ВАЖНО: значения ниже только ЗАСЕВАЮТ настройки при первом запуске. Дальше
# правятся кнопками в /admin и лежат в SETTINGS_FILE — этот файл для них
# больше не читается.
PUBLIC_DAILY_LIMIT=0
# PUBLIC_GLOBAL_DAILY_LIMIT=0  # потолок на ВЕСЬ бот за сутки; 0 — без потолка
#                              # без него тысяча новых аккаунтов по 30 запросов
#                              # выжмет всё совершенно легально
# NEW_ACCOUNT_ID_THRESHOLD=    # id выдаются по возрастанию: аккаунтам с id выше
#                              # порога — половина лимита. Дёшево бьёт по фермам
# PUBLIC_BURST=5           # столько запросов за окно ещё по-человечески
# PUBLIC_BURST_WINDOW=1m   # окно, за которое считается всплеск
# PUBLIC_BAN_FOR=15m       # сколько сидит получивший варн
# PUBLIC_MAX_TOKENS=1024   # потолок ответа для публики
# PUBLIC_MAX_RUNES=2000    # потолок длины вопроса от публики
# MAX_QUEUE=32             # сколько вызовов ждут воркера, дальше — отказ

# Варны. Не правятся из панели: это про то, насколько бот прощающий по
# природе, а не про число, которое крутят посреди флуда.
# PUBLIC_WARN_TTL=720h     # сколько варн висит (30 дней)
# PUBLIC_MAX_WARNS=3       # столько живых варнов — бан навсегда

# --- Картинки (по умолчанию выключены) --------------------------------------
# Генерация картинок платная — нужен ключ от проекта с включённым биллингом.
# Пока IMAGE_MODEL пустой, бот просто говорит, что рисовать не умеет.
#   gpt-image-1, gpt-image-2 — GPT Image (возвращают base64)
#   dall-e-3 — классика (нужен response_format)
# IMAGE_MODEL=
# IMAGE_BASE_URL=          # переопределение эндпоинта для картинок (по умолчанию = LLM_BASE_URL)
# IMAGE_API_KEYS=          # ключ с биллингом, если основной не подходит
# IMAGE_STORAGE_CHAT_ID=   # обязателен при IMAGE_MODEL: guest mode не умеет
#                          # заливать файлы, картинку сперва надо куда-то отправить
# IMAGE_SIZE=1024x1024
# IMAGE_TIMEOUT=2m

# --- Необязательное ---------------------------------------------------------
# ANSWER_CACHE_TTL=10m     # повтор того же вопроса отдаётся из кэша; 0 — выключить
# ALERT_COOLDOWN=15m       # минимальный промежуток между алертами одного вида
# LLM_SYSTEM_PROMPT=Ты — лаконичный помощник в групповом чате Telegram.
# LLM_RAW_SYSTEM_PROMPT=   # чем заменяется промпт, когда админ пишет «-s вопрос»
#                          # значение off выключает флаг совсем
# LLM_MAX_TOKENS=4096      # бюджет общий на размышления и на ответ
# LLM_REASONING_EFFORT=low # none | minimal | low | medium | high | xhigh | max
# LLM_TIMEOUT=30s
# LLM_BASE_URL=            # переопределение эндпоинта, напр. локальная llama.cpp
# LLM_KEY_COOLDOWN=1m      # сколько ключ отдыхает после 429
# MAX_CONCURRENT=8         # сколько запросов к модели идёт одновременно
# MAX_REPLY_RUNES=3500     # длиннее — обрежется по границе абзаца
# MEMORY_TTL=30m           # сколько бот помнит контекст диалога в чате
# COMMAND_REPLY_TTL=30s    # через сколько ответ на /add, /del, /list ужимается
#                          # до «✓»; 0 — оставлять как есть
# LOG_LEVEL=info           # debug | info | warn | error
# STATE_FILE=state.json    # куда пишутся изменения из /add и /del
#                          # в Docker уже задан образом как /data/state.json
# QUOTA_FILE=              # счётчики публичных лимитов и баны
# SETTINGS_FILE=           # настройки, изменённые кнопками в /admin
#                          # оба по умолчанию лежат рядом со STATE_FILE
